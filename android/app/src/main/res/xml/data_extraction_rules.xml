<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials are bound to this device's Keystore; never back them up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
